{
  "$schema": "./color-master-v0.6.0.schema.json",
  "schemaVersion": 3,
  "id": "color-master-v0.6.0",
  "name": "Integrated Color Master Workflow v0.6.0",
  "description": "Profile-driven post-integration workflow for any integrated linear color master.",
  "defaultProfile": "generalColor",
  "profiles": [
    { "id": "generalColor", "name": "General color image", "visibleSteps": ["crop", "gradient", "plateSolve", "colorCalibration", "deconvolution", "noiseReduction", "starSeparation"] },
    { "id": "emissionBroadband", "name": "Broadband color emission nebula", "visibleSteps": ["crop", "gradient", "plateSolve", "colorCalibration", "deconvolution", "noiseReduction", "starSeparation"] },
    { "id": "emissionMapped", "name": "Mapped narrowband color emission nebula", "visibleSteps": ["crop", "gradient", "deconvolution", "noiseReduction", "starSeparation"] },
    { "id": "galaxy", "name": "Galaxy", "visibleSteps": ["crop", "gradient", "plateSolve", "colorCalibration", "deconvolution", "noiseReduction", "starSeparation"] },
    { "id": "starCluster", "name": "Star cluster", "visibleSteps": ["crop", "gradient", "plateSolve", "colorCalibration", "deconvolution", "noiseReduction"] },
    { "id": "custom", "name": "Custom workflow", "visibleSteps": ["crop", "gradient", "plateSolve", "colorCalibration", "deconvolution", "noiseReduction", "starSeparation"] }
  ],
  "input": {
    "stage": "linear-integrated",
    "colorModel": "integrated-color-master",
    "sampleFormat": "any-float"
  },
  "lanes": ["main", "starless", "stars"],
  "steps": [
    {
      "id": "crop",
      "order": 5,
      "enabled": false,
      "stage": "linear",
      "lane": "main",
      "selectedAdapter": "interactiveCrop",
      "adapters": [
        { "id": "interactiveCrop", "kind": "internal" }
      ],
      "requires": ["linear", "rgb"],
      "mustPrecede": ["gradient", "plateSolve", "colorCalibration", "deconvolution", "noiseReduction", "starSeparation"],
      "parameters": { "launchInterface": true, "autoSTF": true, "resume": "rerunWorkflow" }
    },
    {
      "id": "gradient",
      "order": 10,
      "enabled": false,
      "stage": "linear",
      "lane": "main",
      "selectedAdapter": "gradientCorrection",
      "adapters": [
        { "id": "gradientCorrection", "kind": "process", "processClass": "GradientCorrection" },
        { "id": "graxpert", "kind": "process", "processClass": "GraXpert" }
      ],
      "requires": ["linear", "rgb"],
      "mustFollow": ["crop"],
      "mustPrecede": ["plateSolve", "colorCalibration", "deconvolution", "noiseReduction", "starSeparation"],
      "parameters": {}
    },
    {
      "id": "plateSolve",
      "order": 20,
      "enabled": true,
      "stage": "linear",
      "lane": "main",
      "selectedAdapter": "imageSolver",
      "adapters": [
        { "id": "imageSolver", "kind": "internal" }
      ],
      "requires": ["linear", "rgb", "approximateCoordinates", "imageScale"],
      "mustFollow": ["gradient"],
      "mustPrecede": ["colorCalibration"],
      "parameters": {
        "onlyIfNeeded": true,
        "metadataAutofill": true,
        "catalogMode": "automatic",
        "autoLimitMagnitude": true
      }
    },
    {
      "id": "colorCalibration",
      "order": 30,
      "enabled": true,
      "stage": "linear",
      "lane": "main",
      "selectedAdapter": "spcc",
      "adapters": [
        { "id": "spcc", "kind": "process", "processClass": "SpectrophotometricColorCalibration" }
      ],
      "requires": ["linear", "rgb", "astrometricSolution"],
      "mustFollow": ["gradient", "plateSolve"],
      "mustPrecede": ["deconvolution", "noiseReduction", "starSeparation"],
      "parameters": { "catalogId": "GaiaDR3SP", "autoLimitMagnitude": true }
    },
    {
      "id": "deconvolution",
      "order": 40,
      "enabled": true,
      "stage": "linear",
      "lane": "main",
      "selectedAdapter": "blurXTerminator",
      "adapters": [
        { "id": "blurXTerminator", "kind": "process", "processClass": "BlurXTerminator" },
        { "id": "syqonParallax", "kind": "processIcon", "iconId": "CCDASTRO_Parallax" }
      ],
      "requires": ["linear", "rgb", "starsPresent"],
      "mustFollow": ["gradient"],
      "mustPrecede": ["noiseReduction", "starSeparation"],
      "parameters": {}
    },
    {
      "id": "noiseReduction",
      "order": 50,
      "enabled": true,
      "stage": "branch",
      "lane": "starless",
      "selectedAdapter": "noiseXTerminator",
      "adapters": [
        { "id": "noiseXTerminator", "kind": "process", "processClass": "NoiseXTerminator" },
        { "id": "syqonPrism", "kind": "processIcon", "iconId": "CCDASTRO_Prism" }
      ],
      "requires": ["rgb"],
      "mustFollow": ["deconvolution"],
      "parameters": { "placement": "starless", "denoise": 0.75, "iterations": 2 }
    },
    {
      "id": "starSeparation",
      "order": 60,
      "enabled": true,
      "stage": "linear",
      "lane": "main",
      "selectedAdapter": "starXTerminator",
      "adapters": [
        { "id": "starXTerminator", "kind": "process", "processClass": "StarXTerminator" },
        { "id": "starNet2", "kind": "process", "processClass": "StarNet2" },
        { "id": "syqonStarless", "kind": "processIcon", "iconId": "CCDASTRO_Starless" }
      ],
      "requires": ["linear", "rgb"],
      "mustFollow": ["deconvolution"],
      "parameters": { "generateStars": true, "linearSubtraction": true }
    },
    {
      "id": "starlessStretch",
      "order": 70,
      "enabled": false,
      "stage": "branch",
      "lane": "starless",
      "selectedAdapter": "linkedAutoHistogram",
      "adapters": [
        { "id": "linkedAutoHistogram", "kind": "internal" },
        { "id": "unlinkedAutoHistogram", "kind": "internal" }
      ],
      "requires": ["starlessView"],
      "mustFollow": ["starSeparation", "noiseReduction"],
      "parameters": { "targetBackground": 0.18 }
    },
    {
      "id": "starsStretch",
      "order": 80,
      "enabled": false,
      "stage": "branch",
      "lane": "stars",
      "selectedAdapter": "linkedAutoHistogram",
      "adapters": [
        { "id": "linkedAutoHistogram", "kind": "internal" },
        { "id": "unlinkedAutoHistogram", "kind": "internal" }
      ],
      "requires": ["starsView"],
      "mustFollow": ["starSeparation"],
      "parameters": { "targetBackground": 0.08 }
    },
    {
      "id": "recombine",
      "order": 90,
      "enabled": true,
      "stage": "linear",
      "lane": "main",
      "selectedAdapter": "pixelMathAdd",
      "adapters": [
        { "id": "pixelMathAdd", "kind": "internal" }
      ],
      "requires": ["starlessView", "starsView"],
      "mustFollow": ["starlessStretch", "starsStretch"],
      "parameters": { "mode": "add" }
    },
    {
      "id": "finalStretch",
      "order": 92,
      "enabled": true,
      "stage": "nonlinear",
      "lane": "main",
      "selectedAdapter": "linkedAutoHistogram",
      "adapters": [
        { "id": "linkedAutoHistogram", "kind": "internal" },
        { "id": "unlinkedAutoHistogram", "kind": "internal" }
      ],
      "requires": ["recombinedView"],
      "mustFollow": ["recombine"],
      "parameters": { "targetBackground": 0.15 }
    },
    {
      "id": "starReduction",
      "order": 95,
      "enabled": false,
      "stage": "nonlinear",
      "lane": "main",
      "selectedAdapter": "blanshanStarMethodV2",
      "adapters": [
        { "id": "blanshanStarMethodV2", "kind": "internal" }
      ],
      "requires": ["starlessView", "recombinedView"],
      "mustFollow": ["finalStretch"],
      "parameters": { "method": "moderate", "iterations": 1 }
    }
  ]
}
